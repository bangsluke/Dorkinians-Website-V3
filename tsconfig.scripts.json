{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"moduleResolution": "Node16",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./*"],
			"@/lib/*": ["./lib/*"]
		}
	},
	"include": ["scripts/**/*.ts", "lib/**/*.ts"],
	"exclude": ["node_modules", ".next"]
}
